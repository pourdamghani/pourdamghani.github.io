{% if author_profile %}
  <div class="sidebar sticky">
    {% include "author-profile.njk" %}

    {% if page.url == "/publications/" or page.url == "/publications" %}
      <section class="sidebar-topics" aria-label="Publication topics">
        <h3 class="sidebar-topics__title">Topics</h3>
        <nav class="sidebar-topics__links">
          {% for section in publications.sections %}
            {% set section_id = section.title | slugify %}
            <a href="#{{ section_id }}">{{ section.title }}</a>
          {% endfor %}
        </nav>
      </section>
    {% endif %}
    {% if section_links %}
      <section class="sidebar-topics" aria-label="Page sections">
        <h3 class="sidebar-topics__title">Sections</h3>
        <nav class="sidebar-topics__links" aria-label="Page sections">
          {% for section in section_links %}
            <a href="#{{ section | slugify }}">{{ section }}</a>
          {% endfor %}
        </nav>
      </section>
    {% endif %}
  </div>
{% endif %}

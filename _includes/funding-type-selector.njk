<div class="topic-selector funding-type-selector" aria-label="Filter funding by type">
  <span class="topic-selector__label">Browse by type</span>
  <div class="topic-selector__options" role="group" aria-label="Funding types">
    <button type="button" class="topic-selector__button is-active" data-funding-type="all" aria-pressed="true">All funding</button>
    <button type="button" class="topic-selector__button" data-funding-type="supervised" aria-pressed="false">Supervised funding accusation</button>
    <button type="button" class="topic-selector__button" data-funding-type="independent" aria-pressed="false">Independent fundings accusation</button>
  </div>
</div>

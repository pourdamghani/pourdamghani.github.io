<!doctype html>
<html lang="en" class="no-js">
  <head>
    {% include "head.njk" %}
  </head>
  <body class="single-page">
    <header class="home-header" data-home-header>
      <div class="home-header__inner">
        <nav class="home-nav" aria-label="Page sections">
          <a href="#about">Homepage</a>
          <a href="#news">Recent News</a>
          <a href="#publications">Publications</a>
          <a href="#supervision">Supervision</a>
          <a href="#teaching">Teaching</a>
          <a href="#service">Service</a>
          <a href="#talks">Talks</a>
          <a href="#grants">Grants</a>
          <a href="#tools">Tools</a>
        </nav>

        <a class="home-header__cv" href="#cv">CV <span aria-hidden="true">↓</span></a>
      </div>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="home-footer" id="contact">
      <div class="home-footer__inner">
        <nav aria-label="Profile links">
          <a href="{{ metadata.author.googlescholar }}">Google Scholar</a>
          <a href="{{ metadata.author.orcid }}">ORCID</a>
          <a href="https://github.com/{{ metadata.author.github }}">Github</a>
          <a href="https://www.linkedin.com/in/{{ metadata.author.linkedin }}">LinkedIn</a>
        </nav>
        <p class="home-footer__copyright">&copy; 2026 {{ metadata.author.name }}</p>
      </div>
    </footer>

    <script src="/assets/js/single-page-nav.js" defer></script>
  </body>
</html>

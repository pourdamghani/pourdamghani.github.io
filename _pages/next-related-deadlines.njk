<h1>Next Related Deadlines</h1>

{% for category in related_deadlines.categories %}
<section class="research-section">
  <h2>{{ category.title }}</h2>

  <h3>Current deadlines</h3>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">Conference</th>
          <th scope="col">Acronym</th>
          <th scope="col">Rank</th>
          <th scope="col">Next submission deadline</th>
          <th scope="col">Deadline for</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {% for conference in category.conferences %}
          {% if conference.deadline_announced %}
          <tr>
            <td>{{ conference.title }}</td>
            <td>{{ conference.acronym }}</td>
            <td>{{ conference.rank }}</td>
            <td><time datetime="{{ conference.next_submission_deadline }}">{{ conference.next_submission_deadline }}</time></td>
            <td>{{ conference.deadline_for }}</td>
            <td><a href="{{ conference.deadline_source }}">Official page</a></td>
          </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h3>Future deadlines</h3>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">Conference</th>
          <th scope="col">Acronym</th>
          <th scope="col">Rank</th>
          <th scope="col">Previous cycle's submission deadline</th>
          <th scope="col">Deadline for</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {% for conference in category.conferences %}
          {% if not conference.deadline_announced %}
          <tr>
            <td>{{ conference.title }}</td>
            <td>{{ conference.acronym }}</td>
            <td>{{ conference.rank }}</td>
            <td>
              {% if conference.last_submission_deadline %}
                <time datetime="{{ conference.last_submission_deadline }}">{{ conference.last_submission_deadline }}</time>
              {% else %}
                Not available
              {% endif %}
            </td>
            <td>{{ conference.deadline_for }}</td>
            <td><a href="{{ conference.deadline_source }}">Official page</a></td>
          </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endfor %}

<h1>Next Related Deadlines</h1>

<form class="deadline-filters" id="deadline-filters" aria-label="Filter deadlines">
  <div class="deadline-filters__grid">
    <label class="deadline-filters__search" for="deadline-search">
      Name or abbreviation
      <input id="deadline-search" name="query" type="search" autocomplete="off" placeholder="e.g. SIGCOMM or Distributed Computing">
    </label>

    <label for="deadline-from">
      Deadline from
      <input id="deadline-from" name="from" type="date">
    </label>

    <label for="deadline-to">
      Deadline to
      <input id="deadline-to" name="to" type="date">
    </label>

    <label for="deadline-rank">
      Rank
      <select id="deadline-rank" name="rank">
        <option value="">All ranks</option>
        <option value="A*">A*</option>
        <option value="A">A</option>
        <option value="B">B</option>
        <option value="C">C</option>
        <option value="National: India">National: India</option>
        <option value="National: USA">National: USA</option>
        <option value="Journal Published">Journal Published</option>
        <option value="Unranked">Unranked</option>
        <option value="Not listed in iCORE 2026">Not listed in iCORE 2026</option>
      </select>
    </label>

    <label class="deadline-filters__current" for="deadline-current-only">
      <input id="deadline-current-only" name="current" type="checkbox">
      Current deadlines only
    </label>

    <button class="btn deadline-filters__clear" type="reset">Clear filters</button>
  </div>
  <p class="deadline-filters__status" id="deadline-filter-status" role="status" aria-live="polite"></p>
</form>

<div class="deadline-results" id="deadline-filter-results" hidden>
  <section class="deadline-group" id="deadline-results-current">
    <h2>Current deadlines</h2>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th scope="col">Conference</th>
            <th scope="col">Acronym</th>
            <th scope="col">Rank</th>
            <th scope="col">Next submission deadline</th>
            <th scope="col">Previous submission deadline</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody id="deadline-results-current-body"></tbody>
      </table>
    </div>
  </section>

  <section class="deadline-group" id="deadline-results-future">
    <h2>Future deadlines</h2>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th scope="col">Conference</th>
            <th scope="col">Acronym</th>
            <th scope="col">Rank</th>
            <th scope="col">Expected submission deadline</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody id="deadline-results-future-body"></tbody>
      </table>
    </div>
  </section>
</div>

{% for category in related_deadlines.categories %}
{% set dated_future_conferences = category.conferences | selectattr("last_submission_deadline") | rejectattr("deadline_announced") | sort(attribute="last_submission_deadline") %}
{% set undated_future_conferences = category.conferences | rejectattr("last_submission_deadline") | rejectattr("deadline_announced") %}
<details class="research-section deadline-topic" data-deadline-topic>
  <summary><span class="deadline-topic__title" role="heading" aria-level="2">{{ category.title }}</span></summary>

  <section class="deadline-group" data-deadline-group="current">
    <h3>Current deadlines</h3>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th scope="col">Conference</th>
            <th scope="col">Acronym</th>
            <th scope="col">Rank</th>
            <th scope="col">Next submission deadline</th>
            <th scope="col">Previous submission deadline</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {% for conference in category.conferences %}
            {% if conference.deadline_announced %}
            <tr class="deadline-row" data-deadline-row data-deadline-kind="current" data-title="{{ conference.title }}" data-acronym="{{ conference.acronym }}" data-rank="{{ conference.rank }}" data-deadline="{{ conference.next_submission_deadline }}" data-deadline-source="{{ conference.deadline_source }}">
              <td>{{ conference.title }}</td>
              <td>{{ conference.acronym }}</td>
              <td>{{ conference.rank }}</td>
              <td class="deadline-row__deadline"><time datetime="{{ conference.next_submission_deadline }}">{{ conference.next_submission_deadline }}</time></td>
              <td class="deadline-row__previous">
                {% if conference.last_submission_deadline and conference.last_deadline_source %}
                <a href="{{ conference.last_deadline_source }}"><time datetime="{{ conference.last_submission_deadline }}">{{ conference.last_submission_deadline }}</time></a>
                {% else %}
                Not available
                {% endif %}
              </td>
              <td><a href="{{ conference.deadline_source }}">Official page</a></td>
            </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="deadline-group" data-deadline-group="future">
    <h3>Future deadlines</h3>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th scope="col">Conference</th>
            <th scope="col">Acronym</th>
            <th scope="col">Rank</th>
            <th scope="col">Expected submission deadline</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {% for conference in dated_future_conferences %}
            {% if conference.suppress_deadline_estimate %}
            <tr class="deadline-row" data-deadline-row data-deadline-kind="future" data-title="{{ conference.title }}" data-acronym="{{ conference.acronym }}" data-rank="{{ conference.rank }}" data-deadline="">
              <td>{{ conference.title }}</td>
              <td>{{ conference.acronym }}</td>
              <td>{{ conference.rank }}</td>
              <td>
                Not available
                <span class="deadline-estimate">Last verified: <a href="{{ conference.last_deadline_source }}">{{ conference.last_submission_deadline }}</a></span>
              </td>
              <td><a href="{{ conference.deadline_source }}">Official page</a></td>
            </tr>
            {% else %}
              {% set expected_deadline = conference.last_submission_deadline | nextDeadline %}
              <tr class="deadline-row" data-deadline-row data-deadline-kind="future" data-title="{{ conference.title }}" data-acronym="{{ conference.acronym }}" data-rank="{{ conference.rank }}" data-deadline="{{ expected_deadline }}">
                <td>{{ conference.title }}</td>
                <td>{{ conference.acronym }}</td>
                <td>{{ conference.rank }}</td>
                <td>
                  <time datetime="{{ expected_deadline }}">{{ expected_deadline }}</time>
                  <span class="deadline-estimate">Estimated from <a href="{{ conference.last_deadline_source }}">{{ conference.last_submission_deadline }}</a></span>
                </td>
                <td><a href="{{ conference.deadline_source }}">Official page</a></td>
              </tr>
            {% endif %}
          {% endfor %}
          {% for conference in undated_future_conferences %}
            <tr class="deadline-row" data-deadline-row data-deadline-kind="future" data-title="{{ conference.title }}" data-acronym="{{ conference.acronym }}" data-rank="{{ conference.rank }}" data-deadline="">
              <td>{{ conference.title }}</td>
              <td>{{ conference.acronym }}</td>
              <td>{{ conference.rank }}</td>
              <td>Not available</td>
              <td><a href="{{ conference.deadline_source }}">Official page</a></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</details>
{% endfor %}

<p class="deadline-filters__empty" id="deadline-filter-empty" hidden>No deadlines match these filters.</p>

<script src="/assets/js/deadline-filters.js?v=3" defer></script>

---
layout: running-records.njk
permalink: /tools/running-records/
title: Running Records
excerpt: "Running events, finish times, medals, race numbers, and event photos."
---

{% macro recordImage(src, label, eventName, showPlaceholder) %}
  {% if src or showPlaceholder %}
    <figure class="running-record__photo">
      <div class="running-record__image">
        <img src="{{ src if src else '/images/running-records-placeholder.svg' }}" alt="{{ label }}{{ ' from ' if src else ' image placeholder for ' }}{{ eventName }}" width="400" height="220" loading="lazy" decoding="async">
        {% if not src %}<span class="running-record__placeholder" aria-hidden="true">Image placeholder</span>{% endif %}
      </div>
      <figcaption>{{ label }}</figcaption>
    </figure>
  {% endif %}
{% endmacro %}

<div class="running-records-list">
  {% for record in running_records %}
    {% set dateParts = [] %}
    {% if record.date %}{% set dateParts = record.date.split('-') %}{% endif %}
    {% set showPlaceholders = record.show_placeholder_images != false %}
    {% set hasPhotos = record.medal_image or record.race_number_image or record.event_image %}
    <article class="running-record" aria-labelledby="{{ record.id }}">
      <header class="running-record__header">
        <div class="running-record__summary">
          <div class="running-record__title">
            {% if record.logo_image %}<img class="running-record__logo" src="{{ record.logo_image }}" alt="" aria-hidden="true" decoding="async">{% endif %}
            <h2 id="{{ record.id }}">{{ record.name }}</h2>
          </div>
          <dl class="running-record__details">
            <div>
              <dt>Date</dt>
              <dd>{% if record.date %}<time datetime="{{ record.date }}">{{ record.display_date if record.display_date else dateParts[2] + '.' + dateParts[1] + '.' + dateParts[0] }}</time>{% else %}—{% endif %}</dd>
            </div>
            <div>
              <dt>City + Country</dt>
              <dd>{{ record.city }}, {{ record.country }}</dd>
            </div>
          </dl>
        </div>
        <dl class="running-record__performance">
          <div>
            <dt>Distance</dt>
            <dd>{{ record.distance }}</dd>
          </div>
          <div>
            <dt>Time</dt>
            <dd>{{ record.time if record.time else '—' }}</dd>
          </div>
        </dl>
      </header>
      {% if hasPhotos or showPlaceholders %}
        <div class="running-record__photos">
          {{ recordImage(record.medal_image, 'Medal', record.name, showPlaceholders) }}
          {{ recordImage(record.race_number_image, 'Race number', record.name, showPlaceholders) }}
          {{ recordImage(record.event_image, 'Event photo', record.name, showPlaceholders) }}
        </div>
      {% endif %}
    </article>
  {% endfor %}
</div>
